    {
      "name": "Parchment dialog",
      "kind": "custom",
      "refersTo": "modal",
      "description": "Representative introduction dialog content and inner frame; the overlay is described in extensions.",
      "html": "<div class=\"ds-preview\"><section class=\"ds-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ds-dialog-title\"><h2 id=\"ds-dialog-title\">The world is written in numbers.</h2><p>Once, the great equations held our world together. Now they are unraveling. You are an apprentice at the Academy of the Constant. Today, your first trial begins.</p><blockquote>Mathematics is the language of magic.</blockquote><button class=\"ds-primary-button\">Continue<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></button></section></div>",
      "css": ".ds-preview{font-family:Scholar,'Segoe UI',sans-serif;font-size:14px;font-weight:400;color:#253c38}button{font:inherit;color:inherit;cursor:pointer;border:0;transition:background .18s,color .18s,transform .18s,box-shadow .18s}button:disabled{cursor:default}button:focus-visible{outline:3px solid #b87936;outline-offset:5px}button:not(:disabled):active{transform:translateY(1px)}button:disabled:not(.ds-enemy):not(.ds-formula-card){opacity:.48}.ds-modal{position:relative;width:540px;max-width:100%;max-height:calc(100dvh - 48px);overflow-y:auto;background:var(--paper,#f0ecdf);padding:34px 48px;text-align:center;box-shadow:0 20px 80px #061d25a8;border-radius:4px;color:var(--ink,#203f3b);outline:none}.ds-modal:before{content:'';position:absolute;inset:12px;border:1px solid #b5ba9c;pointer-events:none}.ds-modal h2{font:500 39px/1.04 var(--serif,Constant,Georgia,serif);max-width:390px;margin:0 auto 18px}.ds-modal>p{font-size:12px;line-height:1.9;color:#5a6556;margin:14px 0}.ds-modal blockquote{font:italic 20px/1.3 var(--serif,Constant,Georgia,serif);margin:23px 0;color:var(--teal,#2c6961)}.ds-primary-button{background:var(--teal,#2c6961);color:#f8f0db;padding:13px 20px;border-radius:3px;display:flex;gap:16px;align-items:center;justify-content:center;width:100%;font-size:12px;position:relative}.ds-primary-button:hover{background:#194b42}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}"
    }
