      "css": ".ds-preview{font-family:Scholar,'Segoe UI',sans-serif;font-size:14px;font-weight:400;color:#253c38}button:focus-visible{outline:3px solid #b87936;outline-offset:5px}.ds-sigil{width:210px;height:210px;color:#688773;position:relative;display:inline-block}.ds-sigil svg{width:100%;height:100%}.ds-sigil-formula{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--teal,#2c6961);font:500 34px var(--serif,Constant,Georgia,serif);padding-top:1px}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}"
