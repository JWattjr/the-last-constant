  "narrative": {
    "northStar": "The Parchment-and-Ink Academy",
    "overview": "Casting feels like a deliberate mathematical inscription at an academy examination. Warm paper, deep teal spellcraft, antique brass geometry, and literary serif headings establish a learned fantasy world. Compact sans-serif controls keep tactical choices and real arithmetic legible inside that world.\n\nThe premium fantasy TCG direction is expressed through layered card frames, engraved geometric linework, restrained motion, and an illustrated chamber. The current original SVG portraits are explicitly permitted placeholders; final anime-fantasy artwork remains a future supplied asset. Preserve original characters, frames, and symbols. No generated images or image credits are part of this implementation.",
    "keyCharacteristics": [
      "Warm parchment surfaces against a deep teal chamber.",
      "Literary headings paired with compact, practical controls.",
      "Brass hairlines, geometric sigils, and layered formula cards.",
      "Selection and arithmetic remain explicit before a spell is cast.",
      "Original SVG stand-ins preserve the world while final artwork is pending."
    ],
    "rules": [
      {
        "name": "The Inscription Rule",
        "body": "Use teal to connect the formula, geometry, Ink cost, and casting action; preserve visible selected-state borders and labels alongside color.",
        "section": "colors"
      },
      {
        "name": "The Readable Proof Rule",
        "body": "Preserve the final mobile arithmetic override; instructional calculations are functional content, even when ceremonial labels are smaller.",
        "section": "typography"
      },
      {
        "name": "The Paper Depth Rule",
        "body": "Preserve the combination of borders, tonal surfaces, and selective lift; shadows support the paper objects and dialog rather than every text group.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep warm parchment, manuscript ink, teal spellwork, and restrained brass geometry together.",
      "**Do** use the bundled serif for worldbuilding and mathematics, and the bundled sans serif for tactical controls.",
      "**Do** preserve the final mobile arithmetic size and circular variable target dimensions.",
      "**Do** retain written selection states, visible focus, disabled semantics, and reduced-motion support.",
      "**Do** use original SVG portraits and geometric artwork as the current permitted placeholders."
    ],
    "donts": [
      "**Don't** generate images or consume image credits for this implementation.",
      "**Don't** copy another property's characters, card frames, or symbols.",
      "**Don't** treat the placeholder portraits as final anime-fantasy production art.",
      "**Don't** replace explicit arithmetic or state labels with decorative effects alone.",
      "**Don't** claim text fields, generic chips, route navigation, or form-validation states are implemented."
    ]
  }
}
